# BookShelf environment configuration
# Copy to .env and fill in values for production

# Server port (default: 3000)
PORT=3000

# Database URL — leave empty for SQLite default
# For PostgreSQL: postgresql://user:password@localhost:5432/bookshelf_development
DATABASE_URL=

# Rails secret key base (generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)")
SECRET_KEY_BASE=
