<%# locals: book %>
<div class="form-card">
  <h2>Book Details</h2>

  <% if book.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(book.errors.count, "error") %> prevented this book from being saved:</h2>
      <ul>
        <% book.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [:admin, book], data: { turbo_frame: "new_book_form" } do |f| %>
    <div class="form-group">
      <%= f.label :title %>
      <%= f.text_field :title, class: "form-input", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :author %>
      <%= f.text_field :author, class: "form-input", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :isbn, "ISBN" %>
      <%= f.text_field :isbn, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :description %>
      <%= f.text_area :description, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :cover_image_url, "Cover Image URL" %>
      <%= f.url_field :cover_image_url, class: "form-input" %>
    </div>

    <%= f.submit "Add Book", class: "btn-primary" %>
  <% end %>
</div>
